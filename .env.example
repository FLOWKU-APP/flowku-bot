# WAHA
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=your_waha_api_key
WAHA_SESSION=default

# Firestore
FIRESTORE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# App
APP_PORT=8700
WEBHOOK_SECRET=your_webhook_secret

# KirimDev (WhatsApp Cloud API)
KIRIMDEV_API_KEY=kdv_live_your_api_key_here
KIRIMDEV_BASE_URL=https://api.kirimdev.com/v1

# Phone Number ID
WABA_PHONE_NUMBER_ID=your_phone_number_id
PHONE_NUMBER_ID=your_phone_number_id

# Owner phone for reminders (format: 628xxxxxxxxxx)
OWNER_PHONE=628xxxxxxxxxx

# Reminder hours (WIB)
REMINDER_HOUR_1=12
REMINDER_HOUR_2=20

# Chatin Gateway Custom Logic Webhook Integration
CHATIN_WEBHOOK_SECRET=chsec_your_secret_here

